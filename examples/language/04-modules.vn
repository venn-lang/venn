# One file, one module: what it can do, what it knows, and what it lets out.
# Run: venn run examples/language/04-modules.vn

## A file may name itself once. The name is how the module reads in a trace and
## in the editor's outline; nothing resolves through it.
module examples.language.modules

# One word in. A namespace, a verb, a matcher, a type or a value: whatever a
# file reaches that did not come with the language arrives here, by the name
# this file gives it.
import { fmt } from "venn/fmt"

import { slug, initials } from "./shared/text.vn"
import * as text from "./shared/text.vn"

# Nothing leaves a file unless it says so. `shared/text.vn` marks three helpers
# `pub` and keeps `JOINER` and `firstLetter` to itself. Ask for one of those and
# the compiler answers before anything runs:
#   VN2009 · "./shared/text.vn" does not publish firstLetter.
# with a note saying which of the two mistakes it was: declared but not `pub`,
# or not declared at all.

const people = ["Ada Lovelace", "Grace Hopper", "Alan Turing"]

## Named imports and a namespace import are the same file, named two ways.
## Use whichever reads better where it is written.
fn card(name: string) -> map => {
  who: initials(name),
  link: "/people/${slug(name)}",
  label: text.dotted(name, 16)
}

print fmt.table(people.map(one => card(one)))

## There is no default import. A module publishes by name, so there are two
## spellings and not three:
##
##   import text from "./shared/text.vn"
##   VN2009 · A `.vn` module publishes by name, so it has no default.
##     help  Write `import { text } from "…"`, or `import * as text` for the whole of it.

## A name is bound once. The second one used to win in silence, which is how a
## `const fmt = { … }` under an import of `fmt` takes over every `fmt.something`
## below it:
##
##   const slug = "taken"
##   VN2020 · "slug" is already the name of something in this file.
##     see   04-modules.vn:13:1  `slug` is bound here

## Two files that import each other are refused, with the circle written out:
##
##   VN2021 · Importing "./a.vn" here closes a circle.
##     help  Move what both need into another file, and import that from each.
##
## The reason is the order of evaluation rather than tidiness. A `pub const` is
## computed where it stands, so two files in a circle have no order in which
## both are ready: one of them reads the other half-built.
