# open fnDecl issue 264, a compiled pass reuses one slot so every closure reads the last
# open fnExpr issue 264, a compiled pass reuses one slot so every closure reads the last
let made = []
forEach n in [1, 2, 3] {
  let doubled = n * 2
  made = made.push(fn () => doubled)
}
let a = made[0]()
let b = made[1]()
let c = made[2]()
seen = "${a} ${b} ${c}"
