# Deciding between shapes: a union, and the field that tells its branches apart.
# Run: venn run examples/language/07-unions.vn

## Every message this little protocol carries. They have one field in common,
## and its value is different in each, which is what makes the union decidable.
type Ping { kind: "ping", at: number }
type Text { kind: "text", body: string }
type Close { kind: "close", why: string }
type Message = Ping | Text | Close

## One way in per shape, so a list of messages is a list of one type.
fn ping(at: number) -> Message => { kind: "ping", at: at }
fn text(body: string) -> Message => { kind: "text", body: body }
fn close(why: string) -> Message => { kind: "close", why: why }

const inbox: list<Message> = [ping(1), text("hello"), close("done")]

## `match` is the way to decide between them: the pattern asks about `kind` and
## names what that shape carries in the same breath, so `body` is in hand only
## where there is one. Leave a case out and the checker says which.
fn describe(m: Message) -> string => match m {
  { kind: "ping", at }   => "ping at ${at}"
  { kind: "text", body } => "text: ${body}"
  { kind: "close", why } => "closed: ${why}"
}

forEach m in inbox {
  print describe(m)
}

# A chain of `if`s narrows the same way, and the `else` holds whatever no branch
# took: one shape, here, so `why` is readable without asking.
forEach m in inbox {
  if m.kind == "ping" {
    print "still there, at ${m.at}"
  } else if m.kind == "text" {
    print m.body.upper
  } else {
    print "closing because ${m.why}"
  }
}

# Standing on its own, a `match` arm runs steps instead of giving a value back.
# `=>` for a value, `{ … }` for steps: the same split `fn` and `flow` make.
forEach m in inbox {
  match m {
    { kind: "close", why } {
      print "goodbye: ${why}"
    }
    other {
      print "still open"
    }
  }
}

# Three things the checker will not let past, all of them worth trying:
#
#   if m.kind == "pong" { … }        # kind is never "pong": nothing can be it
#
#   if m.kind == "ping" { … }        # and no else: nothing says what to do
#   else if m.kind == "text" { … }   # when kind is "close"
#
#   match m {                        # the same, and here it is the whole point:
#     { kind: "ping" } => "p"        # `match` says these are the cases, so a
#     { kind: "text" } => "t"        # case nobody wrote is one the checker names
#   }
#
# A case nobody wrote is a case that falls through in silence, and a union exists
# to say those are all the cases there are.
