    "@venn/crypto": "workspace:*",
    "@venn/data": "workspace:*",
    "@venn/db": "workspace:*",
    "@venn/env": "workspace:*",
    "@venn/fmt": "workspace:*",
    "@venn/graphql": "workspace:*",
    "@venn/grpc": "workspace:*",
    "@venn/http": "workspace:*",
    "@venn/io": "workspace:*",
    "@venn/load": "workspace:*",
    "@venn/mail": "workspace:*",
    "@venn/mock": "workspace:*",
    "@venn/mqtt": "workspace:*",
    "@venn/notify": "workspace:*",
    "@venn/runtime": "workspace:*",
    "@venn/sdk": "workspace:*",
