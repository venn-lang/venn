{
  "name": "@venn-lang/venn",
  "version": "0.6.0",
  "description": "The venn binary: resolves which version of the language a directory wants, installs it if absent, and hands the command over.",
  "keywords": [
    "venn",
    "testing",
    "e2e",
    "cli",
    "version-manager",
    "toolchain"
  ],
  "homepage": "https://github.com/venn-lang/venn/tree/main/packages/venn#readme",
  "bugs": "https://github.com/venn-lang/venn/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venn-lang/venn.git",
    "directory": "packages/venn"
  },
  "license": "MIT",
  "author": "Vinicius Borges",
  "type": "module",
  "bin": {
    "venn": "./dist/bin/venn.mjs"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.suite.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node carries-no-language.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "node dist/bin/prepare.mjs"
  },
  "dependencies": {
    "@venn-lang/contracts": "workspace:*",
    "@venn-lang/toolchain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
