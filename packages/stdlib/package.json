{
  "name": "@venn-lang/stdlib",
  "version": "0.5.0",
  "description": "The one list of standard-library plugins, plus the fake port implementations the tooling runs them with.",
  "keywords": [
    "venn",
    "testing",
    "e2e",
    "stdlib",
    "standard-library"
  ],
  "homepage": "https://github.com/venn-lang/venn/tree/main/packages/stdlib#readme",
  "bugs": "https://github.com/venn-lang/venn/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venn-lang/venn.git",
    "directory": "packages/stdlib"
  },
  "license": "MIT",
  "author": "Vinicius Borges",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.suite.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@venn-lang/artifacts": "workspace:*",
    "@venn-lang/assert": "workspace:*",
    "@venn-lang/auth": "workspace:*",
    "@venn-lang/browser": "workspace:*",
    "@venn-lang/contracts": "workspace:*",
    "@venn-lang/crypto": "workspace:*",
    "@venn-lang/data": "workspace:*",
    "@venn-lang/date": "workspace:*",
    "@venn-lang/db": "workspace:*",
    "@venn-lang/env": "workspace:*",
    "@venn-lang/fmt": "workspace:*",
    "@venn-lang/graphql": "workspace:*",
    "@venn-lang/grpc": "workspace:*",
    "@venn-lang/http": "workspace:*",
    "@venn-lang/io": "workspace:*",
    "@venn-lang/json": "workspace:*",
    "@venn-lang/load": "workspace:*",
    "@venn-lang/mail": "workspace:*",
    "@venn-lang/math": "workspace:*",
    "@venn-lang/mock": "workspace:*",
    "@venn-lang/mqtt": "workspace:*",
    "@venn-lang/notify": "workspace:*",
    "@venn-lang/runtime": "workspace:*",
    "@venn-lang/sdk": "workspace:*",
    "@venn-lang/types": "workspace:*",
    "@venn-lang/ws": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
