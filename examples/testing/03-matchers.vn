# The words `expect` gains from `@venn/assert`, and the two grouped forms.
# Run it with:  venn test examples/testing/03-matchers.vn

# `expect` is kernel syntax; the words after the subject are not. They arrive
# with a plugin, which is why this line is here.
use "@venn/assert"

flow "matchers read as sentences" {
  const receipt = {
    id: "r-77",
    plan: "pro",
    tags: ["paid", "eu"],
    total: 19.99,
    text: "Total: $19.99 charged to the card ending 4242",
  }

  step "equals compares structure, not identity" {
    expect receipt.tags equals ["paid", "eu"]
    # A trailing `{ … }` after a matcher is always its options, never a value
    # to compare against. Name the map first and the ambiguity goes away.
    const wanted = { paid: true, refunded: false }
    const flags = { paid: true, refunded: false }
    expect flags equals wanted
  }

  step "contains is a substring for text and membership for a list" {
    expect receipt.text contains "4242"
    expect receipt.tags contains "eu"
    # `not` negates the whole clause, matcher included.
    expect not receipt.tags contains "refunded"
  }

  step "oneOf holds a value against a closed set" {
    expect receipt.plan oneOf ["free", "pro", "enterprise"]
  }

  step "closeTo is how money is compared" {
    # 12.50 + 4.00 + 3.49 is 19.990000000000002 in binary floating point, so
    # `==` would be a false alarm waiting to happen.
    const summed = [12.50, 4.00, 3.49].sum
    expect summed closeTo receipt.total { within: 0.001 }
  }

  step "expect.all groups checks that only mean anything together" {
    # Every line has to hold, and the block counts as one expectation in the
    # report. Use it when splitting the lines up would report three half facts
    # instead of one whole one.
    expect.all {
      receipt.id != null
      receipt.total > 0
      receipt.tags.len == 2
    }
  }

  step "expect.soft marks a check that informs rather than blocks" {
    # A slow response is worth recording, but it is not what this step is about.
    # `.soft` travels into the report with the check, so a reviewer can tell the
    # two kinds apart.
    expect.soft receipt.text.len < 200

    # A bare word after the subject is always a matcher, so a method call needs
    # its dot: `receipt.id.startsWith(…)` is an expression, not a matcher.
    expect receipt.id.startsWith("r-")
  }
}
