{
  "name": "@venn-lang/toolchain",
  "version": "0.9.0",
  "description": "Which version of the language a directory is asking for, and where the versions on a machine live.",
  "keywords": [
    "venn",
    "testing",
    "e2e",
    "toolchain",
    "version-manager"
  ],
  "homepage": "https://github.com/venn-lang/venn/tree/main/packages/toolchain#readme",
  "bugs": "https://github.com/venn-lang/venn/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venn-lang/venn.git",
    "directory": "packages/toolchain"
  },
  "license": "MIT",
  "author": "Vinicius Borges",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.suite.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@venn-lang/contracts": "workspace:*",
    "semver": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/semver": "catalog:"
  }
}
