# Trying something that can fail, and what to use when it does.
# Run: venn run examples/basics/16-failure.vn

import { json } from "venn/json"

## `try` as an expression: the attempt, or the value after `else`.
const settings = try json.parse("{ oops") else { port: 8080 }
print "port: ${settings.port}"

## When it works, the attempt is the value and the `else` never runs.
const good = try json.parse('{ "port": 3000 }') else { port: 8080 }
print "port: ${good.port}"

## `catch` gives the failure a name. It has a `message` and a `code`, and the
## code is `VN7000` until the verb that failed carries one of its own.
const why = try json.parse("{ oops") catch e => e.message
print "why: ${why}"

## Which is what lets a function answer for an input it cannot read, without a
## `try` block around every call.
fn portOf(text) => try json.parse(text).port else 8080

const written = '{ "port": 443 }'
print "portOf a number: ${portOf(written)}"
print "portOf nonsense: ${portOf('nonsense')}"

## Nothing is caught but a failure. A `return` inside the attempt is the
## function leaving, not the attempt failing:
fn firstEven(xs) {
  forEach x in xs {
    if x % 2 == 0 {
      return x
    }
  }
  return null
}
const found = try firstEven([1, 3, 6]) else -1
print "first even: ${found}"

## A failure of your own, with a code a caller can recognise and a payload it
## can act on. `fail` alone raises `VN6002`, which says only that something did.
fragment charge(order) {
  if order.amount > 100 {
    fail "over the limit for this card" { code: "pay.limit", data: { over: order.amount - 100 } }
  }
  print "charged ${order.amount}"
}

## What `catch` binds is the `error` type. It is opaque, like `regex`: the
## members below are the whole of it, and `e.nowhere` is refused by `venn check`
## rather than found at three in the morning.
try {
  run charge({ id: 7, amount: 500 })
} catch e {
  print "code:    ${e.code}"
  print "message: ${e.message}"
  print "over by: ${e.data.over}"
}

## Which is what lets one catch tell two failures apart.
try {
  run charge({ id: 8, amount: 900 })
} catch e {
  const next = e.code == "pay.limit" ? "try a smaller amount" : "give up"
  print "next:    ${next}"
}

## Codes beginning `VN` belong to the language, so this is refused where it is
## written:
##
##   fail "no" { code: "VN7010" }
##   VN3022 · "VN7010" begins with VN, and those codes belong to the language.

## The block form is still where steps run rather than where a value is wanted:
##
##   try {
##     step "Payment" { http.post "/api/pay" }
##   } catch e {
##     log "failed: ${e.message}"
##   } finally {
##     mock.reset
##   }
