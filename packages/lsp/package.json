{
  "name": "@venn-lang/lsp",
  "version": "0.7.5",
  "description": "The Venn language server: diagnostics, hover, completion, definition, references, rename, signature help, semantic tokens, formatting, document highlight and quick fixes for .vn files.",
  "keywords": [
    "venn",
    "testing",
    "e2e",
    "lsp",
    "language-server",
    "editor"
  ],
  "homepage": "https://github.com/venn-lang/venn/tree/main/packages/lsp#readme",
  "bugs": "https://github.com/venn-lang/venn/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venn-lang/venn.git",
    "directory": "packages/lsp"
  },
  "license": "MIT",
  "author": "Vinicius Borges",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.suite.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@venn-lang/contracts": "workspace:*",
    "@venn-lang/core": "workspace:*",
    "@venn-lang/project": "workspace:*",
    "@venn-lang/runtime": "workspace:*",
    "@venn-lang/sdk": "workspace:*",
    "@venn-lang/stdlib": "workspace:*",
    "@venn-lang/types": "workspace:*",
    "langium": "catalog:",
    "vscode-languageserver": "catalog:",
    "vscode-languageserver-textdocument": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
