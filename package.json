{
  "name": "venn-language",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --sort run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "pnpm --filter @venn-lang/benchmarks run bench",
    "lint": "biome check .",
    "format": "biome check --write .",
    "changeset": "changeset",
    "venn": "node packages/cli/dist/bin/venn-run.mjs",
    "venn:build": "pnpm -r --sort --filter \"@venn-lang/cli...\" run build",
    "vscode:build": "pnpm -r --sort --filter \"venn...\" run build",
    "vscode:install": "pnpm run vscode:build && node scripts/install-vscode-extension.mjs",
    "vscode:uninstall": "node scripts/install-vscode-extension.mjs --remove",
    "test:coverage": "vitest run --coverage",
    "test:patch": "vitest run --coverage && python scripts/patch-coverage.py",
    "release": "pnpm -r --sort run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsc-api": "npm:typescript@^5.9.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT"
}
