# One line ending everywhere. Without this, a checkout on Windows converts text
# to CRLF, the formatter expects LF, and the lint step fails there and only
# there. Binary files are listed so nothing rewrites them.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.vsix binary
*.woff binary
*.woff2 binary

# Generated by langium-cli and committed on purpose. Collapsed in reviews.
packages/core/src/generated/** linguist-generated=true
pnpm-lock.yaml linguist-generated=true

# GitHub has no Venn highlighter yet. Ruby is the closest match: same comment
# character, similar string and block shapes.
*.vn linguist-language=Ruby
