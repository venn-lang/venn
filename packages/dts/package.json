{
  "name": "@venn-lang/dts",
  "version": "0.7.3",
  "description": "Reads the types an installed npm package publishes and returns them as Venn TypeSpecs.",
  "keywords": [
    "venn",
    "testing",
    "e2e",
    "typescript",
    "declarations"
  ],
  "homepage": "https://github.com/venn-lang/venn/tree/main/packages/dts#readme",
  "bugs": "https://github.com/venn-lang/venn/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venn-lang/venn.git",
    "directory": "packages/dts"
  },
  "license": "MIT",
  "author": "Vinicius Borges",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.suite.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@venn-lang/types": "workspace:*",
    "tsc-api": "npm:typescript@^5.9.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
