  },
  "dependencies": {
    "@venn-lang/contracts": "workspace:*",
    "@venn-lang/types": "workspace:*",
    "langium": "catalog:"
  },
  "devDependencies": {
    "@fast-check/vitest": "catalog:",
    "langium-cli": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
