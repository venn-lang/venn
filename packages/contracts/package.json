{
  "name": "@venn-lang/contracts",
  "version": "0.8.1",
  "description": "The ports the Venn core runs on, their implementations, and the host that carries them.",
  "keywords": [
    "venn",
    "testing",
    "e2e",
    "ports",
    "adapters",
    "conformance"
  ],
  "homepage": "https://github.com/venn-lang/venn/tree/main/packages/contracts#readme",
  "bugs": "https://github.com/venn-lang/venn/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venn-lang/venn.git",
    "directory": "packages/contracts"
  },
  "license": "MIT",
  "author": "Vinicius Borges",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "development": "./src/node.ts",
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs",
      "default": "./dist/node.mjs"
    },
    "./testing": {
      "development": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.suite.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@fast-check/vitest": ">=0.4.0",
    "vitest": ">=4.0.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "@fast-check/vitest": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
