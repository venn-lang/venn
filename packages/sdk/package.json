{
  "name": "@venn-lang/sdk",
  "version": "0.7.0",
  "description": "The plugin authoring API: small typed builders that return plain definition objects.",
  "keywords": [
    "venn",
    "testing",
    "e2e",
    "plugin",
    "sdk"
  ],
  "homepage": "https://github.com/venn-lang/venn/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/venn-lang/venn/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venn-lang/venn.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "author": "Vinicius Borges",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.suite.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@venn-lang/contracts": "workspace:*",
    "@venn-lang/types": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
