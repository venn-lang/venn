{
  "name": "@venn/cli",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "venn": "./dist/bin/venn.mjs"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@venn/assert": "workspace:*",
    "@venn/contracts": "workspace:*",
    "@venn/core": "workspace:*",
    "@venn/dts": "workspace:*",
    "@venn/http": "workspace:*",
    "@venn/io": "workspace:*",
    "@venn/project": "workspace:*",
    "@venn/runtime": "workspace:*",
    "@venn/sdk": "workspace:*",
    "@venn/stdlib": "workspace:*",
    "@venn/types": "workspace:*",
    "citty": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
