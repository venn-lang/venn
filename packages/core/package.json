{
  "name": "@venn-lang/core",
  "version": "0.8.0",
  "description": "The Venn compiler: grammar, parser, type checker, expression compiler, decorator expansion, and the Problem model.",
  "keywords": [
    "venn",
    "testing",
    "e2e",
    "compiler",
    "parser",
    "langium",
    "dsl"
  ],
  "homepage": "https://github.com/venn-lang/venn/tree/main/packages/core#readme",
  "bugs": "https://github.com/venn-lang/venn/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venn-lang/venn.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Vinicius Borges",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.suite.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "langium:generate": "langium generate",
    "prebuild": "pnpm run langium:generate",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@venn-lang/prelude": "workspace:*",
    "@venn-lang/types": "workspace:*",
    "langium": "catalog:"
  },
  "devDependencies": {
    "@fast-check/vitest": "catalog:",
    "langium-cli": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
