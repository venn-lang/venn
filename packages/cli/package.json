{
  "name": "@venn-lang/cli",
  "version": "0.7.0",
  "description": "The venn binary: one command for starting, checking, running and testing a Venn project.",
  "keywords": [
    "venn",
    "testing",
    "e2e",
    "cli",
    "test-runner"
  ],
  "homepage": "https://github.com/venn-lang/venn/tree/main/packages/cli#readme",
  "bugs": "https://github.com/venn-lang/venn/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venn-lang/venn.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Vinicius Borges",
  "type": "module",
  "bin": {
    "venn-run": "./dist/bin/venn-run.mjs",
    "venn-lsp": "./dist/bin/venn-lsp.mjs",
    "venn": "./dist/bin/venn.mjs"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.suite.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@venn-lang/contracts": "workspace:*",
    "@venn-lang/core": "workspace:*",
    "@venn-lang/dts": "workspace:*",
    "@venn-lang/http": "workspace:*",
    "@venn-lang/lsp": "workspace:*",
    "@venn-lang/project": "workspace:*",
    "@venn-lang/runtime": "workspace:*",
    "@venn-lang/sdk": "workspace:*",
    "@venn-lang/stdlib": "workspace:*",
    "@venn-lang/types": "workspace:*",
    "citty": "catalog:",
    "vscode-languageserver": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-xml-parser": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
